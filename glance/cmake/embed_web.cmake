# Embed the dashboard (glance/web/**) into a C++ source file.
#
# Run as a script at build time:
#   cmake -DWEB_DIR=<dir> -DOUT=<file.cpp> -P embed_web.cmake
#
# Every file under WEB_DIR becomes a static byte array plus an entry in
# glance::web::assets(), keyed by its path relative to WEB_DIR ("index.html",
# "app.css", ...) with a content type picked from the extension. The output
# is only rewritten when its content changes, so an untouched dashboard does
# not trigger a recompile.
if(NOT WEB_DIR OR NOT OUT)
  message(FATAL_ERROR "embed_web.cmake needs -DWEB_DIR=... -DOUT=...")
endif()

file(GLOB_RECURSE _files RELATIVE "${WEB_DIR}" "${WEB_DIR}/*")
list(SORT _files)

set(_body "// Generated by cmake/embed_web.cmake from glance/web/ -- do not edit.\n")
string(APPEND _body "#include <cstddef>\n#include <string_view>\n\n#include \"server_dashboard.h\"\n\n")
string(APPEND _body "namespace glance::web {\nnamespace {\n\n")

set(_entries "")
set(_i 0)
foreach(_rel IN LISTS _files)
  if(IS_DIRECTORY "${WEB_DIR}/${_rel}")
    continue()
  endif()
  get_filename_component(_ext "${_rel}" LAST_EXT)
  string(TOLOWER "${_ext}" _ext)
  if(_ext STREQUAL ".html")
    set(_mime "text/html; charset=utf-8")
  elseif(_ext STREQUAL ".css")
    set(_mime "text/css; charset=utf-8")
  elseif(_ext STREQUAL ".js" OR _ext STREQUAL ".mjs")
    set(_mime "text/javascript; charset=utf-8")
  elseif(_ext STREQUAL ".json")
    set(_mime "application/json")
  elseif(_ext STREQUAL ".svg")
    set(_mime "image/svg+xml")
  elseif(_ext STREQUAL ".png")
    set(_mime "image/png")
  elseif(_ext STREQUAL ".ico")
    set(_mime "image/x-icon")
  elseif(_ext STREQUAL ".woff2")
    set(_mime "font/woff2")
  else()
    set(_mime "application/octet-stream")
  endif()

  file(READ "${WEB_DIR}/${_rel}" _hex HEX)
  string(LENGTH "${_hex}" _hexlen)
  math(EXPR _size "${_hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  # Wrap long lines so compilers and diffs stay happy.
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n  " _bytes "${_bytes}")
  if(_size EQUAL 0)
    set(_bytes "0x00")
  endif()
  string(APPEND _body "const unsigned char kData${_i}[] = {\n  ${_bytes}\n};\n\n")
  string(APPEND _entries "    {\"${_rel}\", \"${_mime}\", kData${_i}, ${_size}},\n")
  math(EXPR _i "${_i} + 1")
endforeach()

string(APPEND _body "const Asset kAssets[] = {\n${_entries}    {nullptr, nullptr, nullptr, 0},\n};\n\n")
string(APPEND _body "}  // namespace\n\n")
string(APPEND _body "const Asset* assets() { return kAssets; }\n\n")
string(APPEND _body "const Asset* find_asset(std::string_view path) {\n")
string(APPEND _body "  for (const Asset* a = kAssets; a->path; ++a) {\n")
string(APPEND _body "    if (path == a->path) return a;\n  }\n  return nullptr;\n}\n\n")
string(APPEND _body "}  // namespace glance::web\n")

if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
  if(_old STREQUAL _body)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${_body}")
