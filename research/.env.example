
# ==========================================
# POKER APIS - APPLICATION CONFIGURATION
# ==========================================

POKER_APP_NAME=poker-apis
POKER_APP_VERSION=1.0.0

# Local server configuration
POKER_HOST=127.0.0.1
POKER_PORT=8000
POKER_API_PREFIX=/api/v1

# Application behavior
POKER_DEBUG=false
POKER_DOCS_ENABLED=true

# Maximum upload size: 10 MiB
POKER_MAX_UPLOAD_SIZE_BYTES=10485760

# Logging configuration
POKER_LOG_LEVEL=INFO
